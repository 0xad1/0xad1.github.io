---
layout: layouts/base.njk
---
<article class="thread-page"><header class="thread-header"><div class="meta">{{ kind }} · {{ state }}</div><h1>{{ title }}</h1><p>{{ premise }}</p></header><div class="thread-body"><section><div class="section-kicker">Central question</div><h2>{{ question }}</h2></section><section><div class="section-kicker">{{ contentLabel or 'Field notes' }}</div><div class="article-body">{{ content | safe }}</div></section>{% if relatedWalks %}<section class="thread-related"><div class="section-kicker">Related Walks</div>{% for item in relatedWalks %}<a href="{{ item.url }}">{{ item.title }} <span>↗</span></a>{% endfor %}</section>{% endif %}{% if relatedExperiments %}<section class="thread-related"><div class="section-kicker">Related Experiments</div>{% for item in relatedExperiments %}<a href="{{ item.url }}">{{ item.title }} <span>↗</span></a>{% endfor %}</section>{% endif %}{% if nextDirection %}<section class="thread-next"><div class="section-kicker">Next direction</div><p>{{ nextDirection }}</p></section>{% endif %}</div></article>
