<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description or site.description }}">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="site-shell">

    <!-- Header -->
    <header class="site-header">
      <a class="wordmark" href="index.html" aria-label="ThinkInPark home">ThinkIn<span>Park</span></a>

      <div class="header-actions">
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="walks.html" {% if section == 'walks' %}aria-current="page"{% endif %}>Walks</a>
          <a href="bench.html" {% if section == 'bench' %}aria-current="page"{% endif %}>Bench</a>
          <a href="rabbit-holes.html" {% if section == 'rabbit-holes' %}aria-current="page"{% endif %}>Rabbit Holes</a>
          <a href="experiments.html" {% if section == 'experiments' %}aria-current="page"{% endif %}>Experiments</a>
          <a href="about.html" {% if section == 'about' %}aria-current="page"{% endif %}>About</a>
        </nav>

        <!-- Résumé (header, always visible) -->
        <button class="icon-button" id="resume-toggle-header" data-resume-trigger aria-label="View résumé">⤓</button>

        <!-- Theme toggle -->
        <button class="icon-button" id="theme-toggle" aria-label="Toggle colour theme">◐</button>
      </div>
    </header>

    <!-- Main content -->
    <main>
      {{ content | safe }}
    </main>

    <!-- Footer -->
    <footer class="site-footer">
      <span class="footer-meta">© 2026 ThinkInPark</span>
      <span class="footer-closing">Keep wandering.</span>
      <div class="footer-links">
        <a href="contact.html">Contact</a>
        <button class="button button--quiet" id="resume-toggle" data-resume-trigger>Résumé</button>
      </div>
    </footer>

  </div>

  <script src="script.js"></script>
</body>
</html>
